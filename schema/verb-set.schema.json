{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ryoshin0830/ccverbs/main/schema/verb-set.schema.json",
  "title": "ccverbs verb set",
  "description": "One community-contributed set of Claude Code spinner verbs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "emoji", "description", "language", "category", "tags", "verbs"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor hint. Use \"../schema/verb-set.schema.json\"."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case. Must equal the filename without .json, and be unique across sets."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "description": "Human-readable name shown in the TUI list."
    },
    "emoji": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8,
      "description": "One emoji shown beside the name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "description": "One line explaining what the set is."
    },
    "language": {
      "enum": ["ja", "en", "zh-Hans", "zh-Hant", "ko", "mixed"],
      "description": "Language of the verbs. Use \"mixed\" for term-plus-translation sets."
    },
    "category": {
      "enum": ["meme", "study", "classic"],
      "description": "meme = for fun, study = flashcards, classic = general-purpose replacement."
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
      "description": "Searchable kebab-case keywords."
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "github": { "type": "string" }
      },
      "description": "Credit for whoever wrote the set."
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "Where the content came from, if anywhere."
    },
    "i18n": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional per-locale name and description. Falls back per field to the top-level values.",
      "properties": {
        "en": { "$ref": "#/$defs/localizedText" },
        "ja": { "$ref": "#/$defs/localizedText" },
        "zh-Hans": { "$ref": "#/$defs/localizedText" },
        "zh-Hant": { "$ref": "#/$defs/localizedText" },
        "ko": { "$ref": "#/$defs/localizedText" }
      }
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120,
        "not": { "pattern": "(…|\\.\\.\\.|。)$" },
        "description": "One spinner verb. Claude Code appends the ellipsis, so do not end with one. Keep it within 40 terminal columns."
      },
      "description": "The verbs themselves. 10-40 is a comfortable size."
    }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "description": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
