{
  "name": "ccverbs",
  "version": "0.2.2",
  "description": "Swap Claude Code's spinner verbs from community verb sets",
  "keywords": [
    "claude-code",
    "claude",
    "spinner",
    "cli",
    "tui",
    "spinnerverbs"
  ],
  "homepage": "https://github.com/ryoshin0830/ccverbs#readme",
  "bugs": {
    "url": "https://github.com/ryoshin0830/ccverbs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryoshin0830/ccverbs.git"
  },
  "type": "module",
  "bin": {
    "ccverbs": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "sets:validate": "node scripts/validate-sets.mjs",
    "sets:index": "node scripts/build-index.mjs",
    "prepublishOnly": "npm run sets:validate && npm run build"
  },
  "dependencies": {
    "ink": "^6.0.0",
    "react": "^19.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
